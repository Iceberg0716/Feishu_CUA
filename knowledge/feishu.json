    {
      "name": "send_message_to_target",
      "allowed_states": [
        "messages",
        "calendar",
        "docs",
        "unknown"
      ],
      "preconditions": {
        "app_in_view": true
      },
      "match_any": [
        "发送消息",
        "发消息",
        "通知"
      ],
      "slots": {
        "target": {
          "pattern": "给\\s*(.+?)\\s*(?:发送消息|发消息|发送|通知)\\s+(.+)$",
          "group": 1,
          "replacements": [
            {
              "pattern": "^[\"'“”‘’]+|[\"'“”‘’]+$",
              "with": ""
            }
          ]
        },
        "message": {
          "pattern": "给\\s*(.+?)\\s*(?:发送消息|发消息|发送|通知)\\s+(.+)$",
          "group": 2,
          "stop_patterns": [
            "\\s+并(?:停留|等待).*$",
            "\\s+然后.*$",
            "\\s+之后.*$"
          ],
          "replacements": [
            {
              "pattern": "^[\"'“”‘’：:，,\\s]+|[\"'“”‘’]+$",
              "with": ""
            }
          ]
        }
      },
      "action": {
        "goal": "给指定飞书会话发送消息",
        "actions": [
          {
            "action": "hotkey",
            "params": {
              "keys": [
                "ctrl",
                "1"
              ]
            }
          },
          {
            "action": "wait",
            "params": {
              "ms": 300
            }
          },
          {
            "action": "hotkey",
            "params": {
              "keys": [
                "ctrl",
                "f"
              ]
            }
          },
          {
            "action": "wait",
            "params": {
              "ms": 300
            }
          },
          {
            "action": "type",
            "params": {
              "text": "{{target}}"
            }
          },
          {
            "action": "wait",
            "params": {
              "ms": 500
            }
          },
          {
            "action": "hotkey",
            "params": {
              "keys": [
                "enter"
              ]
            }
          },
          {
            "action": "wait",
            "params": {
              "ms": 700
            }
          },
          {
            "action": "type",
            "params": {
              "text": "{{message}}"
            }
          },
          {
            "action": "wait",
            "params": {
              "ms": 200
            }
          },
          {
            "action": "hotkey",
            "params": {
              "keys": [
                "enter"
              ]
            }
          },
          {
            "action": "wait",
            "params": {
              "ms": 500
            }
          }
        ],
        "verify_each_step": false,
        "stop_on_failure": true
