          {
            "action": "wait",
            "params": {
              "ms": 300
            }
          }
        ],
        "verify_each_step": false,
        "stop_on_failure": true
      },
      "postconditions": {
        "app_in_view": true,
        "state_in": [
          "messages"
        ]
