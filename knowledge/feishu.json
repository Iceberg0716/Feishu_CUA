    {
      "name": "search_text",
      "allowed_states": [
        "messages",
        "docs",
        "calendar"
      ],
      "preconditions": {
        "app_in_view": true,
        "state_in": [
          "messages",
          "docs",
          "calendar"
        ]
      },
      "match_any": [
        "搜索",
        "输入"
      ],
      "slots": {
        "text": {
          "pattern": "输入\\s+(.+)$",
          "stop_patterns": [
            "\\s+并(?:停留|等待|发送|点击).*$",
            "\\s+然后.*$",
            "\\s+之后.*$"
          ],
          "replacements": [
            {
              "pattern": "^[\"'“”‘’]+|[\"'“”‘’]+$",
              "with": ""
            }
          ]
        }
      },
      "action": {
        "goal": "在搜索框中输入文本",
        "actions": [
          {
            "action": "hotkey",
            "params": {
              "keys": [
                "ctrl",
                "f"
              ]
            }
          },
          {
            "action": "wait",
            "params": {
              "ms": 300
            }
          },
          {
            "action": "type",
            "params": {
              "text": "{{text}}"
            }
          }
        ],
        "verify_each_step": false,
        "stop_on_failure": true
      },
      "postconditions": {
        "app_in_view": true,
        "verify_instruction": "在搜索框中输入 {{text}}"
      }
    },
