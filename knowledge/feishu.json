      "name": "open_messages_module",
      "allowed_states": [
        "messages",
        "calendar",
        "docs",
        "unknown"
      ],
      "preconditions": {
        "app_in_view": true,
        "state_in": [
          "messages",
          "calendar",
          "docs",
          "unknown"
        ]
      },
      "match_any": [
        "消息图标",
        "消息模块",
        "打开消息"
