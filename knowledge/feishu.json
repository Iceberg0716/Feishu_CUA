{
  "app_names": [
    "Feishu",
    "Lark",
    "飞书"
  ],
  "launch_commands": [
    "C:\\Program Files\\Feishu\\Feishu.exe",
    "C:\\Program Files (x86)\\Feishu\\Feishu.exe",
    "C:\\Users\\Public\\Desktop\\飞书.lnk",
    "feishu://"
  ],
  "known_page_states": [
    "messages",
    "calendar",
    "docs",
    "sheets",
    "meetings",
    "mail",
    "knowledge",
    "unknown"
  ],
  "stable_home_state": "messages",
  "state_navigation_hotkeys": {
    "messages": ["ctrl", "1"],
    "calendar": ["ctrl", "2"],
    "docs": ["ctrl", "3"],
    "sheets": ["ctrl", "3"],
    "meetings": ["ctrl", "4"],
    "mail": ["ctrl", "5"],
    "knowledge": ["ctrl", "6"]
  },
  "region_preferences": {
    "default": ["content", "top_bar", "left_nav"],
    "messages": ["left_nav", "content", "top_bar"],
    "calendar": ["left_nav", "content", "top_bar"],
    "docs": ["content", "left_nav", "top_bar"],
    "search": ["top_bar", "content", "left_nav"],
    "navigation": ["left_nav", "content", "top_bar"]
  },
  "validation_policies": {
    "default": {
      "verify_after_action": true,
      "verify_each_step": false,
      "stop_on_failure": true
    },
    "click": {
      "verify_after_action": true,
      "verify_each_step": false,
      "stop_on_failure": true
    },
    "type": {
      "verify_after_action": true,
      "verify_each_step": false,
      "stop_on_failure": true
    },
    "chunk": {
      "verify_after_action": true,
      "verify_each_step": true,
      "stop_on_failure": true
    },
    "drag": {
      "verify_after_action": true,
      "verify_each_step": true,
      "stop_on_failure": true
    }
  },
  "recovery_sequences": {
    "global": [
      {"action": "hotkey", "params": {"keys": ["esc"]}}
    ],
    "state_entry": {
      "messages": [
        {"action": "hotkey", "params": {"keys": ["ctrl", "1"]}}
      ],
      "calendar": [
        {"action": "hotkey", "params": {"keys": ["ctrl", "2"]}}
      ],
      "docs": [
        {"action": "hotkey", "params": {"keys": ["ctrl", "3"]}}
      ],
      "meetings": [
        {"action": "hotkey", "params": {"keys": ["ctrl", "4"]}}
      ],
      "mail": [
        {"action": "hotkey", "params": {"keys": ["ctrl", "5"]}}
      ],
      "knowledge": [
        {"action": "hotkey", "params": {"keys": ["ctrl", "6"]}}
      ]
    }
  },
  "task_templates": [
    {
      "name": "open_messages_module",
      "allowed_states": ["messages", "calendar", "docs", "unknown"],
      "preconditions": {
        "app_in_view": true,
        "state_in": ["messages", "calendar", "docs", "unknown"]
      },
      "match_any": ["消息图标", "消息模块", "打开消息"],
      "action": {
        "goal": "打开消息模块",
        "actions": [
          {"action": "hotkey", "params": {"keys": ["ctrl", "1"]}},
          {"action": "wait", "params": {"ms": 300}}
        ],
        "verify_each_step": false,
        "stop_on_failure": true
      },
      "postconditions": {
        "app_in_view": true,
        "state_in": ["messages"]
      }
    },
    {
      "name": "open_calendar_module",
      "allowed_states": ["messages", "calendar", "docs", "unknown"],
      "preconditions": {
        "app_in_view": true,
        "state_in": ["messages", "calendar", "docs", "unknown"]
      },
      "match_any": ["日历图标", "日历模块", "打开日历"],
      "action": {
        "goal": "打开日历模块",
        "actions": [
          {"action": "hotkey", "params": {"keys": ["ctrl", "2"]}},
          {"action": "wait", "params": {"ms": 300}}
        ],
        "verify_each_step": false,
        "stop_on_failure": true
      },
      "postconditions": {
        "app_in_view": true,
        "state_in": ["calendar"]
      }
    },
    {
      "name": "search_text",
      "allowed_states": ["messages", "docs", "calendar"],
      "preconditions": {
        "app_in_view": true,
        "state_in": ["messages", "docs", "calendar"]
      },
      "match_any": ["搜索", "输入"],
      "slots": {
        "text": {
          "pattern": "输入\\s+(.+)$"
        }
      },
      "action": {
        "goal": "在搜索框中输入文本",
        "actions": [
          {"action": "hotkey", "params": {"keys": ["ctrl", "f"]}},
          {"action": "wait", "params": {"ms": 300}},
          {"action": "type", "params": {"text": "{{text}}"}}
        ],
        "verify_each_step": false,
        "stop_on_failure": true
      },
      "postconditions": {
        "app_in_view": true,
        "verify_instruction": "在搜索框中输入 {{text}}"
      }
    }
  ]
}
